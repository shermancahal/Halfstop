<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample Overlooks &amp; Side Roads</name>
    <description>Demonstration data shipped with the site to exercise the KML path: folders, shared styles, a polygon and waypoints. Coordinates are synthetic — replace this file with your own GaiaGPS export.</description>

    <Style id="byway-line">
      <LineStyle><color>ff2f6fd0</color><width>4</width></LineStyle>
    </Style>
    <Style id="area-fill">
      <LineStyle><color>ff3d6f1f</color><width>2</width></LineStyle>
      <PolyStyle><color>553d6f1f</color></PolyStyle>
    </Style>
    <StyleMap id="byway">
      <Pair><key>normal</key><styleUrl>#byway-line</styleUrl></Pair>
      <Pair><key>highlight</key><styleUrl>#byway-line</styleUrl></Pair>
    </StyleMap>

    <Folder>
      <name>Side roads</name>
      <Placemark>
        <name>Creek road spur</name>
        <description><![CDATA[<p>Gravel, passable in a two-wheel-drive car when dry. Dead-ends at a turnaround above the creek.</p>]]></description>
        <styleUrl>#byway</styleUrl>
        <LineString>
          <coordinates>
            -84.0980,35.3905,742 -84.0902,35.3948,796 -84.0841,35.4011,853
            -84.0798,35.4074,905 -84.0762,35.4136,948 -84.0741,35.4198,981
          </coordinates>
        </LineString>
      </Placemark>
      <Placemark>
        <name>Old grade cutoff</name>
        <description>Former logging grade. Rough but scenic; high clearance recommended.</description>
        <styleUrl>#byway</styleUrl>
        <LineString>
          <coordinates>
            -84.0402,35.4310,1102 -84.0338,35.4351,1140 -84.0271,35.4380,1173 -84.0203,35.4396,1188
          </coordinates>
        </LineString>
      </Placemark>
    </Folder>

    <Folder>
      <name>Points of interest</name>
      <Placemark>
        <name>Fire tower footings</name>
        <description>Concrete footings and a survey marker on the high point. No structure remains.</description>
        <ExtendedData>
          <Data name="Access"><value>Short walk from the pullout</value></Data>
          <Data name="Surface"><value>Foot trail</value></Data>
        </ExtendedData>
        <Point><coordinates>-84.0741,35.4198,981</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Valley pullout</name>
        <description>Room for three or four vehicles, with a view back down the drainage.</description>
        <Point><coordinates>-84.0980,35.3905,742</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Managed clearing</name>
        <description>Wildlife opening kept clear by the forest district. Good early-morning viewing.</description>
        <styleUrl>#area-fill</styleUrl>
        <Polygon>
          <outerBoundaryIs><LinearRing><coordinates>
            -84.0620,35.4240,0 -84.0548,35.4262,0 -84.0531,35.4318,0 -84.0597,35.4332,0 -84.0641,35.4291,0 -84.0620,35.4240,0
          </coordinates></LinearRing></outerBoundaryIs>
        </Polygon>
      </Placemark>
    </Folder>
  </Document>
</kml>
