  <metadata>
    <name>Sample Ridge Road</name>
    <desc>Demonstration data shipped with the site so the viewer and catalogue have something to show. The coordinates are synthetic and do not describe a real road — replace this file with your own GaiaGPS export.</desc>
    <time>2025-10-11T13:40:00Z</time>
  </metadata>
  <wpt lat="35.321000" lon="-84.142000">
    <ele>384.0</ele>
    <name>Trailhead parking</name>
    <desc>Gravel lot at the lower end of the ridge road. Vault toilet, no water.</desc>
    <sym>Parking Area</sym>
  </wpt>
  <wpt lat="35.370683" lon="-84.061183">
    <ele>1336.7</ele>
    <name>Hairpin overlook</name>
    <desc>Wide shoulder on the outside of the switchback. Best light in the late afternoon.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="35.424373" lon="-83.978793">
    <ele>1273.5</ele>
    <name>Spring at the gap</name>
    <desc>Piped spring on the uphill side, flowing year round in most seasons.</desc>
    <sym>Drinking Water</sym>
  </wpt>
  <wpt lat="35.472954" lon="-83.907796">
    <ele>375.8</ele>
    <name>Ridge terminus</name>
    <desc>Road surface changes to unmaintained forest road beyond this point.</desc>
    <sym>Flag</sym>
  </wpt>
  <trk>
    <name>Sample Ridge Road — full traverse</name>
    <desc>Climb from the valley floor to the gap, then a gentler descent along the ridge.</desc>
