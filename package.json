{
  "name": "fieldstop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A back-roads atlas and trip planner that works with no signal, published as a subsidiary site of American Byways.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "build": "node tools/build-catalog.mjs",
    "build:icons": "node tools/build-app-icons.mjs",
    "vendor": "node tools/vendor-maplibre.mjs",
    "check": "node tools/build-catalog.mjs --check",
    "dist": "node tools/build-dist.mjs --zip",
    "dist:app": "node tools/build-dist.mjs --app",
    "app:ios": "node tools/app.mjs ios",
    "app:android": "node tools/app.mjs android",
    "test": "node --test test/*.test.mjs",
    "validate:style": "node tools/validate-style.mjs",
    "smoke": "node tools/smoke.mjs",
    "check:layers": "node tools/check-layers.mjs",
    "check:archive": "node tools/check-archive.mjs",
    "check:site": "node tools/check-site.mjs",
    "check:upgrade": "node tools/check-upgrade.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
