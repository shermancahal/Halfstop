{
  "appId": "com.halfstop.app",
  "appName": "Halfstop",
  "webDir": "dist",
  "includePlugins": [
    "@capacitor/app",
    "@capacitor/browser",
    "@capgo/native-purchases"
  ],
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#1f2846",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
